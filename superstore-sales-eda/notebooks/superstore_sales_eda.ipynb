   "outputs": [],
   "source": [
    "df = pd.read_csv(\"../data/sample_superstore.csv\", encoding='latin1')\n",
    "\n",
    "#Sometimes latin1 loads data but keeps hidden characters.\n",
    "df = df.applymap(lambda x: x.strip() if isinstance(x, str) else x)"
   ]
